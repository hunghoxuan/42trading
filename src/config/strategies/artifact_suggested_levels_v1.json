{
  "key": "artifact_suggested_levels_v1",
  "name": "Artifact Suggested Levels v1",
  "kind": "preset",
  "description": "Price-action trigger strategy that reuses the shared chart artifact scoring logic to derive SL and TP.",
  "engine_version": "42trade.strategy.v2",
  "status": "active",
  "market": {
    "symbol": ""
  },
  "params": {
    "reward_rr_floor": 1.5,
    "suggested_level_tfs": "all"
  },
  "indicators": [],
  "rules": [
    {
      "id": "bullish_artifact_suggested",
      "name": "Buy",
      "bias": "bullish",
      "priority": "medium",
      "when": {
        "and": [
          {
            "fn": "bias",
            "args": [
              "bullish"
            ]
          },
          {
            "or": [
              {
                "fn": "pin_bar",
                "args": [
                  "bullish"
                ]
              },
              {
                "fn": "engulfing",
                "args": [
                  "bullish"
                ]
              },
              {
                "fn": "bos",
                "args": [
                  "bullish"
                ]
              },
              {
                "fn": "choch",
                "args": [
                  "bullish"
                ]
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "id": "buy_market_plan",
          "action": "trade",
          "label": "Buy",
          "trade_plan": {
            "direction": "buy",
            "type": "market",
            "entry": "bar.close",
            "sl": "suggested_trade_sl(buy, params.suggested_level_tfs, params.reward_rr_floor)",
            "tp": "suggested_trade_tp(buy, params.suggested_level_tfs, params.reward_rr_floor)"
          }
        }
      ]
    },
    {
      "id": "bearish_artifact_suggested",
      "name": "Sell",
      "bias": "bearish",
      "priority": "medium",
      "when": {
        "and": [
          {
            "fn": "bias",
            "args": [
              "bearish"
            ]
          },
          {
            "or": [
              {
                "fn": "pin_bar",
                "args": [
                  "bearish"
                ]
              },
              {
                "fn": "engulfing",
                "args": [
                  "bearish"
                ]
              },
              {
                "fn": "bos",
                "args": [
                  "bearish"
                ]
              },
              {
                "fn": "choch",
                "args": [
                  "bearish"
                ]
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "id": "sell_market_plan",
          "action": "trade",
          "label": "Sell",
          "trade_plan": {
            "direction": "sell",
            "type": "market",
            "entry": "bar.close",
            "sl": "suggested_trade_sl(sell, params.suggested_level_tfs, params.reward_rr_floor)",
            "tp": "suggested_trade_tp(sell, params.suggested_level_tfs, params.reward_rr_floor)"
          }
        }
      ]
    }
  ],
  "risk": {
    "rr_target": 1.5,
    "max_open_trades": 1,
    "fallback_stop_pct": 0.001,
    "fallback_tp_pct": 0.002
  },
  "metadata": {
    "strategy_type": "artifact_suggested_levels",
    "signal_source": "chart_artifacts",
    "preview_current_bar_only": true
  },
  "min_bars": 20,
  "conditions": {
    "skip_news": true,
    "news_window_minutes": 120
  }
}
