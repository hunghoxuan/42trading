{
  "id": "candle_pattern_trend",
  "key": "candle_pattern_trend",
  "name": "Candle Pattern Trend",
  "description": "Shared candle-pattern strategy. The strategy owns SL and auto-exit; cTrader Trade Config owns Entry, TP and n.Trades.",
  "engine_version": "42trade.strategy.v3",
  "kind": "custom",
  "status": "active",
  "auto_exit": {
    "id": "opposite_structure_event",
    "description": "Exit when a confirmed structure event appears against the open position.",
    "evaluate_on": "closed_bar",
    "timeframe": "strategy",
    "long_when": { "fn": "any_structure_event", "args": ["bearish"] },
    "short_when": { "fn": "any_structure_event", "args": ["bullish"] }
  },
  "market": {
    "symbol": "",
    "tf": ""
  },
  "settings": {
    "trade_config": {
      "sl": "pattern"
    },
    "confluences": {
      "days": "All",
      "time_range": "_60_KZs",
      "overnight_block": "No",
      "weekend_block": "No",
      "minimum_count": "_2",
      "volume_surge": "No",
      "trend_bias": "No",
      "premium_discount": "No",
      "bar_direction": true,
      "ema": "No",
      "vwap": "No",
      "bollinger": "No",
      "rsi": "No",
      "stochastic": "No",
      "macd": "No",
      "ichimoku": "No"
    }
  },
  "params": {
    "stop_lookback": 3,
    "min_stop_pips": 15
  },
  "indicators": [],
  "rules": [
    {
      "id": "bullish_candle_trigger",
      "name": "Bullish Candle Trigger",
      "bias": "bullish",
      "priority": "medium",
      "when": {
        "or": [
          { "fn": "pin_bar", "args": ["bullish"] },
          { "fn": "engulfing", "args": ["bullish"] },
          { "fn": "outside_bar", "args": ["bullish"] }
        ]
      },
      "actions": [
        {
          "id": "open_long",
          "action": "trade.open.long",
          "trade_plan": {
            "direction": "buy",
            "sl": "price_action_sl(buy, params.stop_lookback, 0, params.min_stop_pips)"
          }
        }
      ]
    },
    {
      "id": "bearish_candle_trigger",
      "name": "Bearish Candle Trigger",
      "bias": "bearish",
      "priority": "medium",
      "when": {
        "or": [
          { "fn": "pin_bar", "args": ["bearish"] },
          { "fn": "engulfing", "args": ["bearish"] },
          { "fn": "outside_bar", "args": ["bearish"] }
        ]
      },
      "actions": [
        {
          "id": "open_short",
          "action": "trade.open.short",
          "trade_plan": {
            "direction": "sell",
            "sl": "price_action_sl(sell, params.stop_lookback, 0, params.min_stop_pips)"
          }
        }
      ]
    }
  ],
  "risk": {},
  "conditions": {
    "symbols": ["DE40", "US30", "BTCUSD", "XAUUSD", "EURGBP", "EURUSD", "GBPJPY", "EURJPY"],
    "timeframes": ["m5", "m15", "m30", "h1", "h4"],
    "skip_news": true,
    "news_window_minutes": 30,
    "sessions": [],
    "regime_tags": []
  },
  "metadata": {
    "author": "42trade",
    "preset_scope": "ctrader_and_42trade"
  }
}
