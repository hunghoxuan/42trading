    "evaluate_on": "closed_bar",
    "timeframe": "strategy",
    "long_when": {
      "fn": "chikou_crosses_below_historical_price",
      "args": [26]
    },
    "short_when": {
      "fn": "chikou_crosses_above_historical_price",
      "args": [26]
    }
  },
  "market": { "symbol": "", "tf": "" },
  "settings": { "trade_config": { "sl": "ichimoku_cloud_edge_atr_buffer" } },
