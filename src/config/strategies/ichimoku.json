{
  "id": "ichimoku",
  "key": "ichimoku",
  "name": "Ichimoku",
  "description": "Built-in 9/26/52 Ichimoku strategy. It owns cloud-edge SL and Chikou auto-exit; cTrader owns Entry, TP and n.Trades.",
