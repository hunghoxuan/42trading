{
  "id": "engulfing_structure_event",
  "key": "engulfing_structure_event",
  "name": "Engulfing Structure Event",
  "description": "Engulfing candle aligned with a same-direction structure event. The strategy owns SL and auto-exit; cTrader owns Entry, TP and n.Trades.",
  "engine_version": "42trade.strategy.v3",
  "kind": "custom",
  "status": "active",
  "auto_exit": {
    "id": "opposite_engulfing",
    "description": "Exit when a confirmed engulfing candle forms against the open position.",
    "evaluate_on": "closed_bar",
    "timeframe": "strategy",
    "long_when": { "fn": "engulfing", "args": ["bearish"] },
    "short_when": { "fn": "engulfing", "args": ["bullish"] }
  },
  "enforce_candle_artifact_reaction": false,
  "market": { "symbol": "", "tf": "" },
  "settings": {
    "trade_config": {
      "sl": "pattern"
    },
    "confluences": {}
  },
  "params": {},
  "indicators": [],
  "rules": [
    {
      "id": "bullish_engulfing_structure",
      "name": "Bullish Engulfing + Structure",
      "bias": "bullish",
      "priority": "high",
      "when": {
        "and": [
          { "fn": "engulfing", "args": ["bullish"] },
          { "fn": "any_structure_event", "args": ["bullish"] }
        ]
      },
      "actions": [{ "id": "open_long", "action": "trade.open.long", "trade_plan": { "direction": "buy" } }]
    },
    {
      "id": "bearish_engulfing_structure",
      "name": "Bearish Engulfing + Structure",
      "bias": "bearish",
      "priority": "high",
      "when": {
        "and": [
          { "fn": "engulfing", "args": ["bearish"] },
          { "fn": "any_structure_event", "args": ["bearish"] }
        ]
      },
      "actions": [{ "id": "open_short", "action": "trade.open.short", "trade_plan": { "direction": "sell" } }]
    }
  ],
  "risk": {},
  "conditions": { "symbols": [], "timeframes": [], "sessions": [], "regime_tags": [] },
  "metadata": { "author": "42trade", "preset_scope": "ctrader_and_42trade" }
}
