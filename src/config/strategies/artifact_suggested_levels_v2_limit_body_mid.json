{
  "key": "artifact_suggested_levels_v2_limit_body_mid",
  "name": "PA Levels v2 LMT Mid",
  "kind": "preset",
  "description": "Clone of Artifact Suggested Levels v2 that places buy/sell limit orders at the midpoint of the latest candle body instead of entering market at close.",
  "engine_version": "42trade.strategy.v2",
  "status": "active",
  "market": {
    "symbol": ""
  },
  "params": {
    "reward_rr_floor": 1.5,
    "suggested_level_tfs": "all",
    "suggested_sl_rank": 2,
    "suggested_tp_rank": 2
  },
  "indicators": [],
  "rules": [
    {
      "id": "bullish_artifact_suggested_limit_body_mid",
      "name": "Buy Limit",
      "bias": "bullish",
      "priority": "medium",
      "when": {
        "and": [
          {
            "fn": "bias",
            "args": [
              "bullish"
            ]
          },
          {
            "or": [
              {
                "fn": "pin_bar",
                "args": [
                  "bullish"
                ]
              },
              {
                "fn": "engulfing",
                "args": [
                  "bullish"
                ]
              },
              {
                "fn": "bos",
                "args": [
                  "bullish"
                ]
              },
              {
                "fn": "choch",
                "args": [
                  "bullish"
                ]
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "id": "buy_limit_body_mid_plan",
          "action": "trade",
          "label": "Buy Limit",
          "trade_plan": {
            "direction": "buy",
            "type": "limit",
            "entry": {
              "/": [
                {
                  "+": [
                    {
                      "var": "bar.open"
                    },
                    {
                      "var": "bar.close"
                    }
                  ]
                },
                2
              ]
            },
            "sl": "suggested_trade_sl(buy, params.suggested_level_tfs, params.reward_rr_floor, params.suggested_sl_rank, params.suggested_tp_rank)",
            "tp": "suggested_trade_tp(buy, params.suggested_level_tfs, params.reward_rr_floor, params.suggested_sl_rank, params.suggested_tp_rank)"
          }
        }
      ]
    },
    {
      "id": "bearish_artifact_suggested_limit_body_mid",
      "name": "Sell Limit",
      "bias": "bearish",
      "priority": "medium",
      "when": {
        "and": [
          {
            "fn": "bias",
            "args": [
              "bearish"
            ]
          },
          {
            "or": [
              {
                "fn": "pin_bar",
                "args": [
                  "bearish"
                ]
              },
              {
                "fn": "engulfing",
                "args": [
                  "bearish"
                ]
              },
              {
                "fn": "bos",
                "args": [
                  "bearish"
                ]
              },
              {
                "fn": "choch",
                "args": [
                  "bearish"
                ]
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "id": "sell_limit_body_mid_plan",
          "action": "trade",
          "label": "Sell Limit",
          "trade_plan": {
            "direction": "sell",
            "type": "limit",
            "entry": {
              "/": [
                {
                  "+": [
                    {
                      "var": "bar.open"
                    },
                    {
                      "var": "bar.close"
                    }
                  ]
                },
                2
              ]
            },
            "sl": "suggested_trade_sl(sell, params.suggested_level_tfs, params.reward_rr_floor, params.suggested_sl_rank, params.suggested_tp_rank)",
            "tp": "suggested_trade_tp(sell, params.suggested_level_tfs, params.reward_rr_floor, params.suggested_sl_rank, params.suggested_tp_rank)"
          }
        }
      ]
    }
  ],
  "risk": {
    "rr_target": 1.5,
    "max_open_trades": 1,
    "fallback_stop_pct": 0.001,
    "fallback_tp_pct": 0.002
  },
  "metadata": {
    "strategy_type": "artifact_suggested_levels",
    "signal_source": "chart_artifacts",
    "entry_model": "limit_body_mid",
    "preview_current_bar_only": true,
    "cloned_from": "artifact_suggested_levels_v2"
  },
  "min_bars": 20,
  "conditions": {
    "skip_news": true,
    "news_window_minutes": 120
  }
}
