{
  "key": "golden_cross_v1",
  "name": "Golden Cross v1",
  "kind": "preset",
  "description": "Longer-term 50/200 moving average crossover often used for macro trend direction.",
  "engine_version": "42trade.strategy.v2",
  "params": {
    "fast_period": 50,
    "slow_period": 200,
    "rr_target": 2.5,
    "stop_lookback": 3
  },
  "indicators": [
    {
      "id": "sma_fast",
      "type": "sma",
      "source": "close",
      "length": 50
    },
    {
      "id": "sma_slow",
      "type": "sma",
      "source": "close",
      "length": 200
    }
  ],
  "rules": [
    {
      "id": "entry_long",
      "name": "Buy",
      "bias": "bullish",
      "priority": "medium",
      "when": {
        "crosses_above": [
          {
            "var": "indicators.sma_fast"
          },
          {
            "var": "indicators.sma_slow"
          }
        ]
      },
      "actions": [
        {
          "id": "open_long",
          "action": "trade.open.long",
          "label": "Buy"
        }
      ]
    },
    {
      "id": "entry_short",
      "name": "Sell",
      "bias": "bearish",
      "priority": "medium",
      "when": {
        "crosses_below": [
          {
            "var": "indicators.sma_fast"
          },
          {
            "var": "indicators.sma_slow"
          }
        ]
      },
      "actions": [
        {
          "id": "open_short",
          "action": "trade.open.short",
          "label": "Sell"
        }
      ]
    }
  ],
  "risk": {
    "rr_target": 2.5,
    "stop_lookback": 3,
    "max_open_trades": 1,
    "fallback_stop_pct": 0.001,
    "fallback_tp_pct": 0.0025
  },
  "min_bars": 240
}
