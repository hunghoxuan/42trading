{
  "key": "stoch_reversal_v1",
  "name": "Stochastic Reversal v1",
  "kind": "preset",
  "description": "Uses stochastic oversold and overbought crossovers for reversal timing.",
  "engine_version": "42trade.strategy.v2",
  "params": {
    "period": 14,
    "smooth_period": 3,
    "oversold": 20,
    "overbought": 80,
    "rr_target": 1.5,
    "stop_lookback": 3
  },
  "indicators": [
    {
      "id": "stoch_k",
      "type": "stochastic",
      "length": 14,
      "smooth_period": 3,
      "field": "k"
    }
  ],
  "rules": [
    {
      "id": "entry_long",
      "name": "Buy",
      "bias": "bullish",
      "priority": "medium",
      "when": {
        "crosses_above": [
          {
            "var": "indicators.stoch_k"
          },
          {
            "var": "params.oversold"
          }
        ]
      },
      "actions": [
        {
          "id": "open_long",
          "action": "trade.open.long",
          "label": "Buy"
        }
      ]
    },
    {
      "id": "entry_short",
      "name": "Sell",
      "bias": "bearish",
      "priority": "medium",
      "when": {
        "crosses_below": [
          {
            "var": "indicators.stoch_k"
          },
          {
            "var": "params.overbought"
          }
        ]
      },
      "actions": [
        {
          "id": "open_short",
          "action": "trade.open.short",
          "label": "Sell"
        }
      ]
    }
  ],
  "risk": {
    "rr_target": 1.5,
    "stop_lookback": 3,
    "max_open_trades": 1,
    "fallback_stop_pct": 0.001,
    "fallback_tp_pct": 0.0015
  },
  "min_bars": 40
}
