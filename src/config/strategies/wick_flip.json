{
  "id": "wick_flip",
  "key": "wick_flip",
  "name": "Wick Flip",
  "description": "Multi-candle wick-flip pattern. The strategy owns SL and auto-exit; cTrader owns Entry, TP and n.Trades.",
  "engine_version": "42trade.strategy.v3",
  "kind": "custom",
  "status": "active",
  "auto_exit": {
