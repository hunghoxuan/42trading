    "timeframe": "strategy",
    "long_when": { "fn": "wick_flip", "args": ["bearish"] },
    "short_when": { "fn": "wick_flip", "args": ["bullish"] }
  },
  "market": { "symbol": "", "tf": "" },
  "settings": {
    "trade_config": {
      "sl": "candle_wick_13"
    },
    "confluences": {}
  },
  "params": {},
  "indicators": [],
  "rules": [
    {
      "id": "bullish_wick_flip",
      "name": "Bullish Wick Flip",
      "bias": "bullish",
      "priority": "high",
      "when": { "fn": "wick_flip", "args": ["bullish"] },
      "actions": [{ "id": "open_long", "action": "trade.open.long", "trade_plan": { "direction": "buy" } }]
    },
    {
      "id": "bearish_wick_flip",
      "name": "Bearish Wick Flip",
      "bias": "bearish",
      "priority": "high",
      "when": { "fn": "wick_flip", "args": ["bearish"] },
      "actions": [{ "id": "open_short", "action": "trade.open.short", "trade_plan": { "direction": "sell" } }]
    }
  ],
