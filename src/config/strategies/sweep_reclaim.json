{
  "id": "sweep_reclaim",
  "key": "sweep_reclaim",
  "name": "Sweep Reclaim",
  "description": "Closed-bar sweep/reclaim chain. The strategy owns pattern SL and auto-exit; cTrader owns Entry, TP and n.Trades.",
  "engine_version": "42trade.strategy.v3",
  "kind": "custom",
  "status": "active",
  "auto_exit": {
    "id": "opposite_structure_event",
    "description": "Exit when a confirmed structure event appears against the reclaimed direction.",
    "evaluate_on": "closed_bar",
    "timeframe": "strategy",
    "long_when": { "fn": "any_structure_event", "args": ["bearish"] },
    "short_when": { "fn": "any_structure_event", "args": ["bullish"] }
  },
  "enforce_candle_artifact_reaction": false,
  "market": { "symbol": "", "tf": "" },
  "settings": { "trade_config": { "sl": "pattern" }, "confluences": {} },
  "params": {},
  "indicators": [],
  "rules": [
    {
      "id": "bullish_sweep_reclaim",
      "name": "Bullish Sweep Reclaim",
      "bias": "bullish",
      "when": { "fn": "sweep_reclaim", "args": ["bullish"] },
      "actions": [{ "id": "open_long", "action": "trade.open.long", "trade_plan": { "direction": "buy" } }]
    },
    {
      "id": "bearish_sweep_reclaim",
      "name": "Bearish Sweep Reclaim",
      "bias": "bearish",
      "when": { "fn": "sweep_reclaim", "args": ["bearish"] },
      "actions": [{ "id": "open_short", "action": "trade.open.short", "trade_plan": { "direction": "sell" } }]
    }
  ],
  "risk": {},
  "conditions": { "symbols": [], "timeframes": [], "sessions": [], "regime_tags": [] },
  "metadata": { "author": "42trade", "preset_scope": "ctrader" }
}
