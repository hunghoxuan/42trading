{
  "key": "ema_cross_v1",
  "name": "EMA Cross v1",
  "kind": "preset",
  "description": "Simple fast/slow EMA crossover with fixed 1:2 risk-reward and one open trade at a time.",
  "engine_version": "42trade.strategy.v2",
  "status": "active",
  "params": {
    "fast_period": 9,
    "slow_period": 21,
    "rr_target": 2,
    "stop_lookback": 2
  },
  "indicators": [
    {
      "id": "ema_fast",
      "type": "ema",
      "source": "close",
      "length": 9
    },
    {
      "id": "ema_slow",
      "type": "ema",
      "source": "close",
      "length": 21
    }
  ],
  "rules": [
    {
      "id": "entry_long",
      "name": "Buy",
      "bias": "bullish",
      "priority": "medium",
      "when": {
        "crosses_above": [
          {
            "var": "indicators.ema_fast"
          },
          {
            "var": "indicators.ema_slow"
          }
        ]
      },
      "actions": [
        {
          "id": "open_long",
          "action": "trade.open.long",
          "label": "Buy"
        }
      ]
    },
    {
      "id": "entry_short",
      "name": "Sell",
      "bias": "bearish",
      "priority": "medium",
      "when": {
        "crosses_below": [
          {
            "var": "indicators.ema_fast"
          },
          {
            "var": "indicators.ema_slow"
          }
        ]
      },
      "actions": [
        {
          "id": "open_short",
          "action": "trade.open.short",
          "label": "Sell"
        }
      ]
    }
  ],
  "risk": {
    "rr_target": 2,
    "stop_lookback": 2,
    "max_open_trades": 1,
    "fallback_stop_pct": 0.001,
    "fallback_tp_pct": 0.002
  },
  "min_bars": 40,
  "conditions": {
    "skip_news": true,
    "news_window_minutes": 120
  }
}
