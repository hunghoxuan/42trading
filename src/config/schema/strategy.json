{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "42trade.strategy.v2",
  "title": "42trade Strategy",
  "type": "object",
  "required": [
    "id",
    "name",
    "engine_version",
    "kind",
    "status",
    "params",
    "indicators",
    "rules",
    "risk"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{3,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "engine_version": {
      "type": "string",
      "enum": ["42trade.strategy.v1", "42trade.strategy.v2"]
    },
    "kind": {
      "type": "string",
      "enum": ["custom"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "archived"]
    },
    "market": {
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "tf": { "type": "string" }
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string", "boolean", "null"]
      }
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,64}$"
          },
          "type": {
            "type": "string",
            "enum": ["ema", "sma", "rsi", "roc", "macd", "bollinger", "stochastic", "highest_high", "lowest_low"]
          },
          "source": {
            "type": "string",
            "enum": ["open", "high", "low", "close", "volume"]
          },
          "length": { "type": "number" },
          "fast_length": { "type": "number" },
          "slow_length": { "type": "number" },
          "signal_length": { "type": "number" },
          "stddev": { "type": "number" },
          "smooth_period": { "type": "number" },
          "field": {
            "type": "string",
            "enum": ["macd", "signal", "histogram", "upper", "mid", "lower", "k", "d"]
          }
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "when", "actions"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "when": {},
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "action"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9._-]{1,64}$"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "trade",
                    "notify.toast",
                    "notify.notification",
                    "chart.note",
                    "webhook.post"
                  ]
                },
                "type": {
                  "type": "string"
                },
                "trade_plan": {
                  "type": "object",
                  "properties": {
                    "direction": { "type": "string", "enum": ["buy", "sell"] },
                    "type": { "type": "string", "enum": ["market", "limit", "stop"] },
                    "entry": { "type": ["number", "string", "object", "null"] },
                    "sl": { "type": ["number", "string", "object", "null"] },
                    "tp": { "type": ["number", "string", "object", "null"] }
                  },
                  "additionalProperties": true
                },
                "message": { "type": "string" },
                "url": { "type": "string" },
                "method": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "when", "actions"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "bias": {
            "type": "string",
            "enum": ["bullish", "bearish", "neutral"]
          },
          "priority": {
            "type": "string",
            "enum": ["strong", "medium", "weak"]
          },
          "when": {},
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "action"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9._-]{1,64}$"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "trade",
                    "draw",
                    "notify.toast",
                    "notify.notification",
                    "webhook.post"
                  ]
                },
                "trade_plan": {
                  "type": "object",
                  "properties": {
                    "direction": { "type": "string", "enum": ["buy", "sell"] },
                    "type": { "type": "string", "enum": ["market", "limit", "stop"] },
                    "entry": { "type": ["number", "string", "object", "null"] },
                    "sl": { "type": ["number", "string", "object", "null"] },
                    "tp": { "type": ["number", "string", "object", "null"] }
                  },
                  "additionalProperties": true
                },
                "label": { "type": "string" },
                "color": { "type": "string" },
                "message": { "type": "string" },
                "url": { "type": "string" },
                "method": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "risk": {
      "type": "object",
      "properties": {
        "rr_target": { "type": "number" },
        "stop_lookback": { "type": "number" },
        "max_open_trades": { "type": "number" },
        "fallback_stop_pct": { "type": "number" },
        "fallback_tp_pct": { "type": "number" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
