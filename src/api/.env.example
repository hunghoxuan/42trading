# =========================
# Quick Start — copy this file to .env
#   cp src/api/.env.example src/api/.env
# =========================

# =========================
# Core server
# =========================
# REQUIRED — HTTP port where webhook listens
PORT=80

# OPTIONAL — enable TLS/HTTPS
HTTPS_ENABLED=false
# HTTPS_PORT=443
# HTTPS_KEY_PATH=
# HTTPS_CERT_PATH=
# HTTPS_CA_PATH=
# HTTPS_REDIRECT_HTTP=true

# OPTIONAL — enable Redis
REDIS_ENABLED=false

# OPTIONAL — runtime automation provider
# Use `bullmq` for queue-backed recurring workers and background scheduling.
# Use `node_timer` only when you explicitly want single-process in-memory timers.
AUTOMATION_PROVIDER=bullmq

# OPTIONAL — process role and runtime leadership guard
# `all` = HTTP + background automation
# `web` = HTTP only
# `runtime` = background automation only
APP_ROLE=all
# Recommended with Redis: exactly one background runtime leader.
RUNTIME_LEADER_LOCK_ENABLED=true
RUNTIME_LEADER_LOCK_KEY=42trade:runtime:leader
RUNTIME_LEADER_LOCK_TTL_MS=45000
RUNTIME_LEADER_HEARTBEAT_MS=15000
# Refuse to keep hidden duplicate background runtimes alive.
RUNTIME_STRICT_PROCESS_GUARD=true
# `exit` = follower/all duplicate background process terminates itself.
# `keepalive` = allow non-leader `APP_ROLE=all` process to stay up for HTTP only.
RUNTIME_FOLLOWER_POLICY=exit

# REQUIRED — shared secret for x-api-key header auth
SIGNAL_API_KEY=replace_with_long_random_key

# OPTIONAL — Telegram notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# OPTIONAL — override the user-scoped data root
# Default after repo setup: ../../data/default
# ROOT_FOLDER=../../data/default

# OPTIONAL — bars storage backend
# Default is parquet+DuckDB.
BARS_STORAGE_PROVIDER=parquet_duckdb
BARS_DUCKDB_PATH=../../data/bars.duckdb

# OPTIONAL — risk limits
# ALLOW_SYMBOLS=
# MAX_RISK_PCT=5

# =========================
# Data folder root
# =========================
# OPTIONAL — override base path for snapshots/, trade_files/, logs/.
# Default: webhook/ directory.
# ROOT_FOLDER=/opt/trading/webhook

# =========================
# AI & Data Providers
# =========================
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TWELVE_DATA_API_KEY=

# =========================
# MT5 bridge
# =========================
MT5_ENABLED=true
MT5_STORAGE=sqlite
# MT5_STORAGE=postgres
# MT5_POSTGRES_URL=postgresql://user:pass@host:5432/mt5_bridge
MT5_TV_ALERT_API_KEYS=
MT5_EA_API_KEYS=
MT5_DEFAULT_LOT=0.01
MT5_DEFAULT_USER_ID=default
MT5_DB_PATH=./mt5-signals.db
MT5_PRUNE_ENABLED=true
MT5_PRUNE_DAYS=14
MT5_PRUNE_INTERVAL_MINUTES=60
MT5_PYTHON_BRIDGE_ENABLED=true
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=3002
# MT5_PYTHON_BRIDGE_API_KEY=change-me

# =========================
# Binance executor
# =========================
# BINANCE_MODE=paper
# BINANCE_PRODUCT=spot
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_DEFAULT_QTY=
# BINANCE_DEFAULT_QUOTE_QTY=50
# BINANCE_RECV_WINDOW=5000

# =========================
# cTrader executor
# =========================
# CTRADER_MODE=demo
# CTRADER_EXECUTOR_URL=
# CTRADER_EXECUTOR_API_KEY=

# =========================
# Webhook UI auth
# =========================
UI_AUTH_ENABLED=true
UI_BOOTSTRAP_EMAIL=admin@example.com
UI_BOOTSTRAP_PASSWORD=change_me_bootstrap_password
UI_SESSION_JWT_SECRET=
UI_DEMO_USER_USERNAME=user
UI_DEMO_USER_EMAIL=user@example.test
UI_DEMO_USER_PASSWORD=123456
UI_DEMO_SELLER_USERNAME=seller
UI_DEMO_SELLER_EMAIL=seller@example.test
UI_DEMO_SELLER_PASSWORD=123456
UI_SESSION_TTL_SECONDS=604800
UI_AUTH_STATE_PATH=./ui-auth.json
