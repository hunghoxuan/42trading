# Branch staging routing example (Nginx)
#
# Recommended: subdomain-per-branch (cleaner for frontend assets/cookies)
# Example:
#   feature-x.trade.mozasolution.com -> localhost:18081
#
# Alternative (path-prefix) is possible but may require frontend base-path handling.

server {
    listen 443 ssl http2;
    server_name feature-x.trade.mozasolution.com;

    # ssl_certificate ...;
    # ssl_certificate_key ...;

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Path-prefix variant (less recommended):
# location /feature-x/ {
#     rewrite ^/feature-x/?(.*)$ /$1 break;
#     proxy_pass http://127.0.0.1:18081;
