{
  "trade_plan_paths": [
    "trade_plan",
    "analysis_data[].trade_plan",
    "symbols[].trade_plan",
    "analyses[].trade_plan"
  ],
  "symbol_paths": [
    "symbol",
    "analysis_data[].symbol",
    "symbols[].symbol",
    "analyses[].symbol"
  ],
  "fields": {
    "symbol": { "label": "Symbol", "readonly": true, "mapping": "trade_plan[].symbol || analysis_data[].symbol" },
    "direction": { "label": "Direction", "readonly": true, "mapping": "trade_plan[].direction || action" },
    "entry": { "label": "Entry", "readonly": true, "mapping": "trade_plan[].entry_price || trade_plan[].entry" },
    "sl": { "label": "SL", "readonly": true, "mapping": "trade_plan[].stop_loss || trade_plan[].sl" },
    "tp": { "label": "TP", "readonly": true, "mapping": "trade_plan[].multiple_exits.tp3.price || trade_plan[].tp || trade_plan[].take_profit" },
    "tp2": { "label": "TP2", "readonly": true, "mapping": "trade_plan[].multiple_exits.tp2.price || trade_plan[].tp2" },
    "tp1": { "label": "TP1", "readonly": true, "mapping": "trade_plan[].multiple_exits.tp1.price || trade_plan[].tp1" },
    "rr": { "label": "RR", "readonly": true, "mapping": "trade_plan[].risk_reward || trade_plan[].rr" },
    "confidence": { "label": "Confidence", "readonly": true, "mapping": "trade_plan[].risk_management.confidence_pct || trade_plan[].confidence_pct || trade_plan[].confidence" },
    "risk_pct": { "label": "Risk %", "readonly": true, "mapping": "trade_plan[].risk_management.risk_percent || trade_plan[].risk_percent || trade_plan[].risk_pct" },
    "strategy": { "label": "Strategy", "readonly": true, "mapping": "trade_plan[].strategy" },
    "entry_model": { "label": "Entry Model", "readonly": true, "mapping": "trade_plan[].entry_model" },
    "session": { "label": "Session", "readonly": true, "mapping": "trade_plan[].session" },
    "profile": { "label": "Profile", "readonly": true, "mapping": "trade_plan[].profile" },
    "order_type": { "label": "Order Type", "readonly": true, "mapping": "trade_plan[].order_type || trade_plan[].type" },
    "estimated_bars": { "label": "Est. Bars", "readonly": true, "mapping": "trade_plan[].risk_management.estimate_mins_that_entry_happens || trade_plan[].estimated_bars || trade_plan[].estimated_candles_to_tp1" },
    "note": { "label": "Note", "readonly": false, "mapping": "trade_plan[].note" },
    "entry_condition": { "label": "Entry Condition", "readonly": false, "mapping": "trade_plan[].risk_management.entry_trigger || trade_plan[].entry_condition || trade_plan[].entry_trigger" },
    "exit_condition": { "label": "Exit Condition", "readonly": false, "mapping": "trade_plan[].risk_management.mid_trade_invalidation || trade_plan[].exit_condition" },
    "invalidation": { "label": "Invalidation", "readonly": false, "mapping": "trade_plan[].risk_management.pre_entry_invalidation || trade_plan[].invalidation" },
    "skip_recommendation": { "label": "Skip Rec", "readonly": false, "mapping": "trade_plan[].risk_management.skip_decision || trade_plan[].trade_decision || trade_plan[].skip_recommendation" },
    "risk_management": { "label": "Risk Mgmt", "readonly": false, "mapping": "trade_plan[].risk_management" },
    "confluence_checklist": { "label": "Confluence", "readonly": false, "mapping": "analysis_data[].multi_timeframes_analysis.confluence_checklist || trade_plan[].confluence_checklist" }
  }
}
