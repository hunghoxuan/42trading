FROM node:20-alpine AS ui-build
WORKDIR /app/web-ui
COPY web-ui/package*.json ./
RUN npm install --no-audit --no-fund
COPY web-ui/ ./
RUN npm run build

FROM node:20-alpine AS webhook-deps
WORKDIR /app/webhook
COPY webhook/package*.json ./
RUN npm install --omit=dev --no-audit --no-fund

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app/webhook

COPY webhook/ ./
COPY --from=webhook-deps /app/webhook/node_modules ./node_modules
COPY --from=ui-build /app/web-ui/dist /app/web-ui/dist

EXPOSE 80
CMD ["node", "server.js"]
